{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "the-desk/feed.schema.json",
  "title": "Product Feed edition",
  "description": "Written each morning by the product-feed agent to ~/agent-house/desks/product-feed/feed.json and read by The Desk.",
  "type": "object",
  "required": ["desk", "edition", "themes", "articles"],
  "additionalProperties": true,
  "properties": {
    "desk": { "const": "product-feed" },
    "edition": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date of the edition, Toronto time" },
    "note": { "type": "string", "maxLength": 300 },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "url", "themes", "summary", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "source": { "type": "string", "minLength": 1, "maxLength": 80 },
          "author": { "type": "string", "maxLength": 120 },
          "date": { "type": "string", "description": "Publish date as YYYY-MM-DD, or empty when unknown", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
          "url": { "type": "string", "pattern": "^https://" },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 240 },
          "themes": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
          "summary": { "type": "string", "minLength": 20, "maxLength": 500, "description": "Two or three sentences in the agent's own words" },
          "why": { "type": "string", "minLength": 10, "maxLength": 200, "description": "One line on why it matters for Snow's goals" }
        }
      }
    }
  }
}
