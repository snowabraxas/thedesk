{
  "name": "the-desk",
  "version": "0.1.0",
  "description": "The illustrated home of Snow's Agent House.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "preview": "PORT=3000 DESK_HOME=.desk-preview node --watch server/index.js",
    "start": "node server/index.js",
    "deploy": "node scripts/deploy.js",
    "test": "TZ=America/Toronto node --test 'test/**/*.test.js'",
    "validate-feed": "node scripts/validate-feed.js",
    "validate-news": "node scripts/validate-news.js",
    "screens": "node scripts/screens.js",
    "screens-home": "node scripts/screens-home.js",
    "service:install": "node scripts/service.js install",
    "service:uninstall": "node scripts/service.js uninstall",
    "service:start": "node scripts/service.js start",
    "service:stop": "node scripts/service.js stop",
    "service:restart": "node scripts/service.js restart",
    "service:status": "node scripts/service.js status"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
